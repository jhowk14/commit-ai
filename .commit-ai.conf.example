# commit-ai 2.0 configuration file
# Location: ~/.commit-ai.conf

# Default commit format: conventional | gitmoji
format=conventional

# Auto-confirm commits without prompt: true | false
auto_confirm=false

# Ask to push after commit: true | false
ask_push=false

# Use custom prompt file (~/.commit-ai-prompt.txt): true | false
use_custom_prompt=false

# AI Provider: gemini | openai
provider=openai

# Model to use (depends on provider)
# Examples for OpenAI / Compatible:
# - OpenAI: gpt-4o-mini, gpt-4o, o3-mini
# - OpenRouter: meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat
# - Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# - DeepSeek: deepseek-chat, deepseek-reasoner
# - Ollama: llama3.2, qwen2.5-coder:7b, deepseek-r1:8b
# - Cerebras: gpt-oss-120b, llama-3.3-70b, gemma-4-31b
# Examples for Gemini:
# - Gemini: gemini-3-flash-preview, gemini-2.5-flash, gemini-2.0-flash
model=gpt-4o-mini

# Base URL for OpenAI-compatible providers:
# - OpenAI Official: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Groq: https://api.groq.com/openai/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Ollama (Local): http://localhost:11434/v1
# - LM Studio (Local): http://localhost:1234/v1
# - Cerebras: https://api.cerebras.ai/v1
openai_base_url=https://api.openai.com/v1

# API Keys (optional - native provider variables are also supported:
# GEMINI_API_KEY, OPENAI_API_KEY, CEREBRAS_API_KEY, OPENROUTER_API_KEY,
# GROQ_API_KEY and DEEPSEEK_API_KEY)
# gemini_api_key=your_gemini_key_here
# openai_api_key=your_openai_or_compatible_key_here
